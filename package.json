{
  "name": "playwright-qa-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node app/server.mjs",
    "test": "playwright test --grep-invert @visual",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:all": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "test:server": "node --test tests/server-persistence.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run audit",
    "security:scan": "docker build --platform linux/amd64 -f Dockerfile.security -t playwright-portfolio-security . && docker run --rm playwright-portfolio-security"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0"
  }
}
